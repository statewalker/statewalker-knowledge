{
  "name": "@statewalker/notebook-build",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Build notebooks from a FilesApi into a static site of executable notebook pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-knowledge.git",
    "directory": "packages/notebook-build"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-knowledge/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-knowledge/tree/main/packages/notebook-build#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-browser.json",
    "test:browser": "pnpm --filter @statewalker/notebook-db run build && vitest run test-browser --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@observablehq/notebook-kit": "catalog:",
    "markdown-it": "catalog:"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@statewalker/db-duckdb-browser": "catalog:",
    "@statewalker/notebook-db": "workspace:^",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "@types/jsdom": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@statewalker/webrun-builder": "catalog:peers",
    "@statewalker/webrun-files": "catalog:peers",
    "@statewalker/webrun-modules": "catalog:peers"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
