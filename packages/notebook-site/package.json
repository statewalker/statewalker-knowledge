{
  "name": "@statewalker/notebook-site",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Compose a SiteHandler serving a built notebook site: pages, module dependencies and the rebuild event stream.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "test:browser": "vitest run test-browser --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-browser.json"
  },
  "dependencies": {
    "@statewalker/webrun-http-events": "catalog:"
  },
  "peerDependencies": {
    "@statewalker/webrun-files": "catalog:peers",
    "@statewalker/webrun-site-builder": "catalog:peers"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-http-browser": "catalog:",
    "@statewalker/webrun-site-host": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
