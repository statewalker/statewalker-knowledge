{
  "name": "@statewalker/notebook-db",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Back notebook-kit SQL cells with any @statewalker/db-api database.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-knowledge.git",
    "directory": "packages/notebook-db"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-knowledge/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-knowledge/tree/main/packages/notebook-db#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "test:browser": "vitest run test-browser --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-browser.json"
  },
  "peerDependencies": {
    "@statewalker/db-api": "catalog:peers",
    "@statewalker/webrun-files": "catalog:peers"
  },
  "devDependencies": {
    "@observablehq/notebook-kit": "catalog:",
    "@statewalker/db-api": "catalog:",
    "@statewalker/db-duckdb-browser": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "@statewalker/webrun-modules": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
